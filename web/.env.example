# ==========================================
# StepFlow Environment Variables
# ==========================================

# Supabase Credentials (from your Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# App Base URL (Change to your deployed domain on Vercel e.g. https://stepflow.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Laragon / Local MySQL Database Configuration (Optional, prioritized over JSON if provided)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=stepflow_db

